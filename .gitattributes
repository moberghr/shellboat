# Line endings are LF everywhere (the repository is LF; .editorconfig says the same). Without this, a Windows
# checkout with git's default autocrlf=true would convert the vendored sources and test fixtures to CRLF.
* text=auto eol=lf

# Shell scripts must be LF regardless — a CRLF shebang line makes the kernel look for an interpreter whose
# name ends in \r, and the script fails with "bad interpreter".
*.sh text eol=lf

# Binaries, so nothing tries to normalise them.
*.png binary
*.ico binary
*.jpg binary
*.pdf binary
*.ttf binary
*.otf binary
*.dylib binary
*.so binary
*.dll binary
*.zip binary
