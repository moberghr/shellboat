<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Shellboat.App.ViewModels"
        xmlns:c="using:Shellboat.App.Controls"
        x:Class="Shellboat.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Shellboat"
        Icon="/Assets/shellboat-256.png"
        Width="1280" Height="800" MinWidth="720" MinHeight="420"
        Background="{DynamicResource Bg.Window}">

  <DockPanel>
    <!-- The main menu: shown here on Windows/Linux; on macOS it lives in the system menu bar and this is empty. -->
    <NativeMenuBar DockPanel.Dock="Top"/>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Bg.Chrome}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="10,3">
      <TextBlock Text="{Binding StatusText}" Classes="Caption" TextTrimming="CharacterEllipsis"/>
    </Border>

    <Grid ColumnDefinitions="280,4,*">
      <!-- ============ Left: connection tree ============ -->
      <DockPanel Grid.Column="0" Background="{DynamicResource Bg.Chrome}" ClipToBounds="True">
        <Grid DockPanel.Dock="Top" Margin="4,8,8,4" ColumnDefinitions="Auto,*">
          <TextBox Grid.Column="1" Name="FilterBox" Text="{Binding Tree.Filter}" PlaceholderText="Filter connections…"/>
          <Button Grid.Column="0" Classes="Toolbar" Margin="0,0,2,0" VerticalAlignment="Center" Command="{Binding OpenSettingsCommand}" ToolTip.Tip="Settings" Padding="7,5">
            <PathIcon Width="15" Height="15" Data="{StaticResource Glyph.gear}" Foreground="{DynamicResource Text.Muted}"/>
          </Button>
        </Grid>

        <!-- Footer: the two add buttons (Settings sits beside the filter). Import lives in the menu (and the empty state below). -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="6,4">
          <WrapPanel Orientation="Horizontal">
              <Button Classes="Toolbar" Command="{Binding NewConnectionCommand}" ToolTip.Tip="New connection">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Width="15" Height="15" Data="{StaticResource Icon.NewConnection}" Foreground="{DynamicResource Accent.Brand}"/>
                  <TextBlock Text="Connection" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button Classes="Toolbar" Command="{Binding NewFolderCommand}" ToolTip.Tip="New folder">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Width="15" Height="15" Data="{StaticResource Icon.NewFolder}" Foreground="{DynamicResource Accent.Brand}"/>
                  <TextBlock Text="Folder" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </WrapPanel>
        </Border>

        <Grid>
        <!-- Empty state: only while nothing is saved yet. ZIndex: the TreeView below shares this cell and its
             Transparent background is hit-testable, so without it the empty tree swallows the button's clicks. -->
        <StackPanel ZIndex="1" IsVisible="{Binding Tree.HasNoConnections}" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Margin="16" Spacing="10">
          <TextBlock Classes="Caption" TextAlignment="Center" TextWrapping="Wrap"
                     Text="No connections yet. Add one below, or bring them over from another app."/>
          <Button HorizontalAlignment="Center" Content="Import connections ▾">
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedLeft">
                <MenuItem Header="From Royal TSX / Royal TS (.rtsz)…" Command="{Binding ImportRoyalCommand}"/>
                <MenuItem Header="From Ásbrú Connection Manager (.yml)…" Command="{Binding ImportAsbruCommand}"/>
                <MenuItem Header="From KeePass (.kdbx)…" Command="{Binding ImportKeePassCommand}"/>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </StackPanel>

        <TreeView Name="ConnectionTree"
                  ItemsSource="{Binding Tree.Roots}"
                  SelectedItem="{Binding Tree.Selected}"
                  Background="Transparent">
          <TreeView.ItemContainerTheme>
            <ControlTheme TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}" x:DataType="vm:TreeNodeViewModel">
              <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            </ControlTheme>
          </TreeView.ItemContainerTheme>
          <TreeView.ItemTemplate>
            <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="vm:TreeNodeViewModel">
              <Border Name="Row" Background="Transparent" Padding="0,2" CornerRadius="4"
                      Classes.drop="{Binding IsDropTarget}">
                <Border.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Connect" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ConnectCommand}" CommandParameter="{Binding}"/>
                    <MenuItem Header="Open SFTP (files)" IsVisible="{Binding IsSsh}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenSftpCommand}" CommandParameter="{Binding}"/>
                    <MenuItem Header="Copy password" IsVisible="{Binding IsConnection}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CopyPasswordCommand}" CommandParameter="{Binding}"/>
                    <MenuItem Header="Edit / Rename" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).EditCommand}" CommandParameter="{Binding}"/>
                    <MenuItem Header="Duplicate" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DuplicateCommand}" CommandParameter="{Binding}"/>
                    <MenuItem Header="Change icon…" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ChangeIconCommand}" CommandParameter="{Binding}"/>
                    <Separator/>
                    <MenuItem Header="New folder here" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).NewFolderCommand}"/>
                    <MenuItem Header="New connection here" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).NewConnectionCommand}"/>
                    <Separator/>
                    <MenuItem Header="Delete" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeleteCommand}" CommandParameter="{Binding}"/>
                  </ContextMenu>
                </Border.ContextMenu>
                <Border.Styles>
                  <Style Selector="Border.drop">
                    <Setter Property="Background" Value="{DynamicResource Bg.Select}"/>
                  </Style>
                </Border.Styles>
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <PathIcon Width="14" Height="14" Data="{Binding IconKey, Converter={x:Static c:ResourceGeometry.Instance}}"
                            Foreground="{Binding IconBrushKey, Converter={x:Static c:ResourceBrush.Instance}}"/>
                  <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding Subtitle}" Classes="Caption" VerticalAlignment="Center"/>
                </StackPanel>
              </Border>
            </TreeDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>
        </Grid>
      </DockPanel>

      <GridSplitter Grid.Column="1" Background="{DynamicResource Border}" ResizeDirection="Columns"/>

      <!-- ============ Right: session tabs ============ -->
      <Grid Grid.Column="2">
        <TextBlock IsVisible="{Binding !HasTabs}" HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextAlignment="Center" Classes="Caption"
                   Text="Double-click a connection to open it.&#10;Connection (bottom left) adds one; File → Import pulls them from Royal TSX, Ásbrú or KeePass."/>

        <TabControl Name="SessionTabs" IsVisible="{Binding HasTabs}" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}" Padding="0">
          <TabControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SessionTabViewModel">
              <Grid RowDefinitions="*,Auto" Background="Transparent">
                <Grid.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Duplicate tab" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DuplicateTabCommand}" CommandParameter="{Binding}"/>
                    <MenuItem Header="Open SFTP (files)" IsVisible="{Binding IsSsh}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenSftpForTabCommand}" CommandParameter="{Binding}"/>
                    <MenuItem Header="Reconnect" IsVisible="{Binding CanReconnect}" Command="{Binding ConnectCommand}"/>
                    <MenuItem Header="Copy password" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CopyTabPasswordCommand}" CommandParameter="{Binding}"/>
                    <Separator/>
                    <MenuItem Header="Rename tab…" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RenameTabCommand}" CommandParameter="{Binding}"/>
                    <MenuItem Header="Tab color" ItemsSource="{Binding TabColorOptions}">
                      <MenuItem.ItemContainerTheme>
                        <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:TabColorOption">
                          <Setter Property="Header" Value="{Binding Label}"/>
                          <Setter Property="Command" Value="{Binding Apply}"/>
                          <Setter Property="Icon">
                            <Template>
                              <Ellipse Width="10" Height="10" Fill="{Binding SwatchBrushKey, Converter={x:Static c:ResourceBrush.Instance}}"/>
                            </Template>
                          </Setter>
                        </ControlTheme>
                      </MenuItem.ItemContainerTheme>
                    </MenuItem>
                    <MenuItem Header="Change icon…" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ChangeTabIconCommand}" CommandParameter="{Binding}"/>
                    <MenuItem Header="Detach to window" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DetachTabCommand}" CommandParameter="{Binding}"/>
                    <MenuItem Header="Show in connection tree" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShowTabInTreeCommand}" CommandParameter="{Binding}"/>
                    <Separator/>
                    <MenuItem Header="Close" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CloseTabCommand}" CommandParameter="{Binding}"/>
                    <MenuItem Header="Close other tabs" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CloseOtherTabsCommand}" CommandParameter="{Binding}"/>
                  </ContextMenu>
                </Grid.ContextMenu>
                <Border Grid.Row="1" Height="3" CornerRadius="1.5" Margin="0,3,0,0" IsVisible="{Binding HasTabColor}"
                        Background="{Binding TabColor, Converter={x:Static c:ResourceBrush.Instance}}"/>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Width="13" Height="13" Data="{Binding IconKey, Converter={x:Static c:ResourceGeometry.Instance}}"
                            Foreground="{Binding IconBrushKey, Converter={x:Static c:ResourceBrush.Instance}}"/>
                  <Ellipse Width="7" Height="7" Fill="{DynamicResource Ok.Green}" IsVisible="{Binding IsConnected}"/>
                  <Ellipse Width="7" Height="7" Fill="{DynamicResource Error.Red}" IsVisible="{Binding !IsConnected}"/>
                  <TextBlock Text="{Binding Title}" FontSize="13" MaxWidth="220" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                  <Button Content="✕" Padding="4,0" FontSize="11" Background="Transparent" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CloseTabCommand}" CommandParameter="{Binding}" ToolTip.Tip="Close"/>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </TabControl.ItemTemplate>
          <TabControl.ContentTemplate>
            <DataTemplate x:DataType="vm:SessionTabViewModel">
              <c:SessionHost/>
            </DataTemplate>
          </TabControl.ContentTemplate>
        </TabControl>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
