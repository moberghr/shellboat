<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Shellboat design tokens — same graphite/steel/teal family as Bearing so the two tools sit together.
       Semantic keys only: reference as {DynamicResource Bg.Window} etc. -->
  <SolidColorBrush x:Key="Bg.Window"     Color="#0F1319"/>
  <SolidColorBrush x:Key="Bg.Chrome"     Color="#161B21"/>
  <SolidColorBrush x:Key="Bg.Editor"     Color="#1A2027"/>
  <SolidColorBrush x:Key="Bg.Select"     Color="#223440"/>
  <SolidColorBrush x:Key="Bg.Hover"      Color="#222831"/>
  <SolidColorBrush x:Key="Bg.TileActive" Color="#2A323C"/>
  <SolidColorBrush x:Key="Border"        Color="#2A323C"/>
  <SolidColorBrush x:Key="Text.Primary"  Color="#D8DEE6"/>
  <SolidColorBrush x:Key="Text.Muted"    Color="#8B95A1"/>
  <SolidColorBrush x:Key="Text.Dim"      Color="#79838F"/>
  <SolidColorBrush x:Key="Accent.Brand"  Color="#35D0BE"/>
  <SolidColorBrush x:Key="Warn.Amber"    Color="#E3B457"/>
  <SolidColorBrush x:Key="Error.Red"     Color="#D2555A"/>
  <SolidColorBrush x:Key="Ok.Green"      Color="#98BB6C"/>
  <SolidColorBrush x:Key="Kind.Ssh"      Color="#6FA6E2"/>
  <SolidColorBrush x:Key="Kind.Rdp"      Color="#978BE4"/>

  <!-- Terminal defaults (the palette for indexed colours lives in Shellboat.Terminal.TerminalPalette). -->
  <Color x:Key="Terminal.Background">#0F1319</Color>
  <Color x:Key="Terminal.Foreground">#D8DEE6</Color>
  <Color x:Key="Terminal.Cursor">#35D0BE</Color>
  <Color x:Key="Terminal.Selection">#3A35D0BE</Color>

  <FontFamily x:Key="MonoFontFamily">JetBrains Mono,Cascadia Mono,Cascadia Code,Menlo,Consolas,DejaVu Sans Mono,monospace</FontFamily>

  <!-- Folder / ssh / rdp glyphs (16×16). PathIcon FILLS its geometry, so every glyph is a closed shape;
       F0 = even-odd fill, which turns the inner rectangles into cut-outs (screen) and the shapes inside them back to ink. -->
  <StreamGeometry x:Key="Icon.Folder">M1.5,3.5 L6,3.5 L7.5,5 L14.5,5 L14.5,13 L1.5,13 Z</StreamGeometry>
  <!-- SSH: terminal window with a heavy title bar, a ">" prompt and a "_" cursor. -->
  <StreamGeometry x:Key="Icon.Ssh">F0 M1,2 L15,2 L15,14 L1,14 Z M2.3,4.4 L13.7,4.4 L13.7,12.7 L2.3,12.7 Z M4,6.2 L7.6,8.5 L4,10.8 L4,9.3 L5.4,8.5 L4,7.7 Z M8.4,10 L12,10 L12,11.3 L8.4,11.3 Z</StreamGeometry>
  <!-- RDP: monitor on a stand with a 2×2 tiled desktop on the screen. -->
  <StreamGeometry x:Key="Icon.Rdp">F0 M1,1.5 L15,1.5 L15,11.5 L1,11.5 Z M2.3,2.8 L13.7,2.8 L13.7,10.2 L2.3,10.2 Z M5.3,3.9 L7.7,3.9 L7.7,6.2 L5.3,6.2 Z M8.3,3.9 L10.7,3.9 L10.7,6.2 L8.3,6.2 Z M5.3,6.8 L7.7,6.8 L7.7,9.1 L5.3,9.1 Z M8.3,6.8 L10.7,6.8 L10.7,9.1 L8.3,9.1 Z M7.2,11.5 L8.8,11.5 L8.8,13.3 L7.2,13.3 Z M4.5,13.3 L11.5,13.3 L11.5,14.5 L4.5,14.5 Z</StreamGeometry>
  <!-- SFTP tab: folder with a down arrow cut out of it. -->
  <StreamGeometry x:Key="Icon.Sftp">F0 M1,3 L6,3 L7.5,4.5 L15,4.5 L15,14 L1,14 Z M7.2,6.5 L8.8,6.5 L8.8,9.6 L10.6,9.6 L8,12.4 L5.4,9.6 L7.2,9.6 Z</StreamGeometry>
  <!-- A file: page with a folded corner. -->
  <StreamGeometry x:Key="Icon.File">F0 M3,1 L10,1 L14,5 L14,15 L3,15 Z M4.3,2.3 L8.4,2.3 L8.4,6.6 L12.7,6.6 L12.7,13.7 L4.3,13.7 Z</StreamGeometry>
</ResourceDictionary>
