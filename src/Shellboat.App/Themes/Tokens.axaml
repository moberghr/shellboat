<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Shellboat design tokens — same graphite/steel/teal family as Bearing so the two tools sit together.
       Semantic keys only: reference as {DynamicResource Bg.Window} etc. -->
  <SolidColorBrush x:Key="Bg.Window"     Color="#0F1319"/>
  <SolidColorBrush x:Key="Bg.Chrome"     Color="#161B21"/>
  <SolidColorBrush x:Key="Bg.Editor"     Color="#1A2027"/>
  <SolidColorBrush x:Key="Bg.Select"     Color="#223440"/>
  <SolidColorBrush x:Key="Bg.Hover"      Color="#222831"/>
  <SolidColorBrush x:Key="Bg.TileActive" Color="#2A323C"/>
  <SolidColorBrush x:Key="Border"        Color="#2A323C"/>
  <SolidColorBrush x:Key="Text.Primary"  Color="#D8DEE6"/>
  <SolidColorBrush x:Key="Text.Muted"    Color="#8B95A1"/>
  <SolidColorBrush x:Key="Text.Dim"      Color="#79838F"/>
  <SolidColorBrush x:Key="Accent.Brand"  Color="#35D0BE"/>
  <SolidColorBrush x:Key="Warn.Amber"    Color="#E3B457"/>
  <SolidColorBrush x:Key="Error.Red"     Color="#D2555A"/>
  <SolidColorBrush x:Key="Ok.Green"      Color="#98BB6C"/>
  <SolidColorBrush x:Key="Kind.Ssh"      Color="#6FA6E2"/>
  <SolidColorBrush x:Key="Kind.Rdp"      Color="#978BE4"/>

  <!-- Terminal defaults (the palette for indexed colours lives in Shellboat.Terminal.TerminalPalette). -->
  <Color x:Key="Terminal.Background">#0F1319</Color>
  <Color x:Key="Terminal.Foreground">#D8DEE6</Color>
  <Color x:Key="Terminal.Cursor">#35D0BE</Color>
  <Color x:Key="Terminal.Selection">#3A35D0BE</Color>

  <FontFamily x:Key="MonoFontFamily">JetBrains Mono,Cascadia Mono,Cascadia Code,Menlo,Consolas,DejaVu Sans Mono,monospace</FontFamily>

  <!-- Folder / ssh / rdp glyphs (16×16). -->
  <StreamGeometry x:Key="Icon.Folder">M1.5,3.5 L6,3.5 L7.5,5 L14.5,5 L14.5,13 L1.5,13 Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Ssh">M1.5,2.5 L14.5,2.5 L14.5,13.5 L1.5,13.5 Z M4,6 L6.5,8 L4,10 M8,10.5 L12,10.5</StreamGeometry>
  <StreamGeometry x:Key="Icon.Rdp">M1.5,2.5 L14.5,2.5 L14.5,11 L1.5,11 Z M5.5,14 L10.5,14 M8,11 L8,14</StreamGeometry>
</ResourceDictionary>
