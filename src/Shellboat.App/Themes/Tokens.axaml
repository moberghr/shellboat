<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Shellboat design tokens — same graphite/steel/teal family as Bearing so the two tools sit together.
       Semantic keys only: reference as {DynamicResource Bg.Window} etc. -->
  <!-- Light/Dark: follows Application.RequestedThemeVariant (Settings → Appearance). Keep the key sets identical. -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="Bg.Window"     Color="#0F1319"/>
      <SolidColorBrush x:Key="Bg.Chrome"     Color="#161B21"/>
      <SolidColorBrush x:Key="Bg.Editor"     Color="#1A2027"/>
      <SolidColorBrush x:Key="Bg.Select"     Color="#223440"/>
      <SolidColorBrush x:Key="Bg.Hover"      Color="#222831"/>
      <SolidColorBrush x:Key="Bg.TileActive" Color="#2A323C"/>
      <SolidColorBrush x:Key="Bg.Overlay"    Color="#E6161B21"/>
      <SolidColorBrush x:Key="Bg.Viewport"   Color="#0F1115"/>
      <SolidColorBrush x:Key="Border"        Color="#2A323C"/>
      <SolidColorBrush x:Key="Text.Primary"  Color="#D8DEE6"/>
      <SolidColorBrush x:Key="Text.Muted"    Color="#8B95A1"/>
      <SolidColorBrush x:Key="Text.Dim"      Color="#79838F"/>
      <SolidColorBrush x:Key="Accent.Brand"  Color="#35D0BE"/>
      <SolidColorBrush x:Key="Warn.Amber"    Color="#E3B457"/>
      <SolidColorBrush x:Key="Error.Red"     Color="#D2555A"/>
      <SolidColorBrush x:Key="Ok.Green"      Color="#98BB6C"/>
      <SolidColorBrush x:Key="Kind.Ssh"      Color="#6FA6E2"/>
      <SolidColorBrush x:Key="Kind.Rdp"      Color="#978BE4"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="Bg.Window"     Color="#F6F8FA"/>
      <SolidColorBrush x:Key="Bg.Chrome"     Color="#ECEFF3"/>
      <SolidColorBrush x:Key="Bg.Editor"     Color="#FFFFFF"/>
      <SolidColorBrush x:Key="Bg.Select"     Color="#CFE7EC"/>
      <SolidColorBrush x:Key="Bg.Hover"      Color="#E2E6EB"/>
      <SolidColorBrush x:Key="Bg.TileActive" Color="#D9DEE4"/>
      <SolidColorBrush x:Key="Bg.Overlay"    Color="#F0ECEFF3"/>
      <SolidColorBrush x:Key="Bg.Viewport"   Color="#E2E6EB"/>
      <SolidColorBrush x:Key="Border"        Color="#D0D6DD"/>
      <SolidColorBrush x:Key="Text.Primary"  Color="#1F262E"/>
      <SolidColorBrush x:Key="Text.Muted"    Color="#56616D"/>
      <SolidColorBrush x:Key="Text.Dim"      Color="#66717D"/>
      <SolidColorBrush x:Key="Accent.Brand"  Color="#0E8F81"/>
      <SolidColorBrush x:Key="Warn.Amber"    Color="#A8761C"/>
      <SolidColorBrush x:Key="Error.Red"     Color="#C2414A"/>
      <SolidColorBrush x:Key="Ok.Green"      Color="#4C8A2E"/>
      <SolidColorBrush x:Key="Kind.Ssh"      Color="#2F6FB7"/>
      <SolidColorBrush x:Key="Kind.Rdp"      Color="#6A5BC9"/>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- Terminal colours are not here: they come from Terminal/TerminalTheme (Settings can force light or dark
       independently of the app theme). -->

  <FontFamily x:Key="MonoFontFamily">JetBrains Mono,Cascadia Mono,Cascadia Code,Menlo,Consolas,DejaVu Sans Mono,monospace</FontFamily>

  <!-- Folder / ssh / rdp glyphs (16×16). PathIcon FILLS its geometry, so every glyph is a closed shape;
       F0 = even-odd fill, which turns the inner rectangles into cut-outs (screen) and the shapes inside them back to ink. -->
  <StreamGeometry x:Key="Icon.Folder">M1.5,3.5 L6,3.5 L7.5,5 L14.5,5 L14.5,13 L1.5,13 Z</StreamGeometry>
  <!-- SSH: terminal window with a heavy title bar, a ">" prompt and a "_" cursor. -->
  <StreamGeometry x:Key="Icon.Ssh">F0 M1,2 L15,2 L15,14 L1,14 Z M2.3,4.4 L13.7,4.4 L13.7,12.7 L2.3,12.7 Z M4,6.2 L7.6,8.5 L4,10.8 L4,9.3 L5.4,8.5 L4,7.7 Z M8.4,10 L12,10 L12,11.3 L8.4,11.3 Z</StreamGeometry>
  <!-- RDP: monitor on a stand with a 2×2 tiled desktop on the screen. -->
  <StreamGeometry x:Key="Icon.Rdp">F0 M1,1.5 L15,1.5 L15,11.5 L1,11.5 Z M2.3,2.8 L13.7,2.8 L13.7,10.2 L2.3,10.2 Z M5.3,3.9 L7.7,3.9 L7.7,6.2 L5.3,6.2 Z M8.3,3.9 L10.7,3.9 L10.7,6.2 L8.3,6.2 Z M5.3,6.8 L7.7,6.8 L7.7,9.1 L5.3,9.1 Z M8.3,6.8 L10.7,6.8 L10.7,9.1 L8.3,9.1 Z M7.2,11.5 L8.8,11.5 L8.8,13.3 L7.2,13.3 Z M4.5,13.3 L11.5,13.3 L11.5,14.5 L4.5,14.5 Z</StreamGeometry>
  <!-- SFTP tab: folder with a down arrow cut out of it. -->
  <StreamGeometry x:Key="Icon.Sftp">F0 M1,3 L6,3 L7.5,4.5 L15,4.5 L15,14 L1,14 Z M7.2,6.5 L8.8,6.5 L8.8,9.6 L10.6,9.6 L8,12.4 L5.4,9.6 L7.2,9.6 Z</StreamGeometry>
  <!-- Settings tabs. Appearance: a circle half filled (light/dark). Keyboard: a keyboard with keys and a space bar. -->
  <StreamGeometry x:Key="Icon.Appearance">F0 M1.5,8 A6.5,6.5 0 1 0 14.5,8 A6.5,6.5 0 1 0 1.5,8 Z M8,2.9 L8,13.1 A5.1,5.1 0 0 1 8,2.9 Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Keyboard">F0 M0.8,3.5 L15.2,3.5 L15.2,12.5 L0.8,12.5 Z M2,4.7 L14,4.7 L14,11.3 L2,11.3 Z M3,5.7 L4.6,5.7 L4.6,7.1 L3,7.1 Z M5.6,5.7 L7.2,5.7 L7.2,7.1 L5.6,7.1 Z M8.8,5.7 L10.4,5.7 L10.4,7.1 L8.8,7.1 Z M11.4,5.7 L13,5.7 L13,7.1 L11.4,7.1 Z M3,8 L4.6,8 L4.6,9.3 L3,9.3 Z M11.4,8 L13,8 L13,9.3 L11.4,9.3 Z M5.4,9.6 L10.6,9.6 L10.6,10.6 L5.4,10.6 Z</StreamGeometry>
  <!-- A file: page with a folded corner. -->
  <StreamGeometry x:Key="Icon.File">F0 M3,1 L10,1 L14,5 L14,15 L3,15 Z M4.3,2.3 L8.4,2.3 L8.4,6.6 L12.7,6.6 L12.7,13.7 L4.3,13.7 Z</StreamGeometry>
  <!-- Footer "new" buttons. New connection: a session window with a plus inside. New folder: the folder with a
       plus cut out (one plus polygon, not two crossing bars, or even-odd would refill the centre). -->
  <StreamGeometry x:Key="Icon.NewConnection">F0 M1,2 L15,2 L15,14 L1,14 Z M2.3,4.4 L13.7,4.4 L13.7,12.7 L2.3,12.7 Z M7.35,5.9 L8.65,5.9 L8.65,7.9 L10.65,7.9 L10.65,9.2 L8.65,9.2 L8.65,11.2 L7.35,11.2 L7.35,9.2 L5.35,9.2 L5.35,7.9 L7.35,7.9 Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.NewFolder">F0 M1.5,3.5 L6,3.5 L7.5,5 L14.5,5 L14.5,13 L1.5,13 Z M7.35,6.4 L8.65,6.4 L8.65,8.35 L10.6,8.35 L10.6,9.65 L8.65,9.65 L8.65,11.6 L7.35,11.6 L7.35,9.65 L5.4,9.65 L5.4,8.35 L7.35,8.35 Z</StreamGeometry>
  <!-- Pickable row glyphs (16×16, "Change icon…"). Names are stored in connections.json — never rename a key.
       Generated shapes, all closed; F0 = even-odd so inner shapes cut holes. terminal/monitor/folder = the defaults. -->
  <StreamGeometry x:Key="Glyph.terminal">F0 M1,2 L15,2 L15,14 L1,14 Z M2.3,4.4 L13.7,4.4 L13.7,12.7 L2.3,12.7 Z M4,6.2 L7.6,8.5 L4,10.8 L4,9.3 L5.4,8.5 L4,7.7 Z M8.4,10 L12,10 L12,11.3 L8.4,11.3 Z</StreamGeometry>
  <StreamGeometry x:Key="Glyph.monitor">F0 M1,1.5 L15,1.5 L15,11.5 L1,11.5 Z M2.3,2.8 L13.7,2.8 L13.7,10.2 L2.3,10.2 Z M5.3,3.9 L7.7,3.9 L7.7,6.2 L5.3,6.2 Z M8.3,3.9 L10.7,3.9 L10.7,6.2 L8.3,6.2 Z M5.3,6.8 L7.7,6.8 L7.7,9.1 L5.3,9.1 Z M8.3,6.8 L10.7,6.8 L10.7,9.1 L8.3,9.1 Z M7.2,11.5 L8.8,11.5 L8.8,13.3 L7.2,13.3 Z M4.5,13.3 L11.5,13.3 L11.5,14.5 L4.5,14.5 Z</StreamGeometry>
