<Project Sdk="Microsoft.NET.Sdk">

  <!-- Thin desktop entry point. All UI lives in Shellboat.App. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>shellboat</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Win32 icon baked into the .exe (Explorer, taskbar, Alt+Tab); ignored for osx-*/linux-* RIDs. The window
         icon is separate (Shellboat.App/Assets, set in MainWindow.axaml). Forward slashes for cross-publishing. -->
    <ApplicationIcon>../../assets/brand/icons/shellboat.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shellboat.App\Shellboat.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
  </ItemGroup>

</Project>
